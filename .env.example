# ---- 공통 ----
GENIO_ENV=dev
GENIO_SECRET_KEY=change-me-to-a-long-random-string
# 워크스페이스 API 키 암호화용 Fernet 키.
# 생성: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GENIO_FERNET_KEY=
GENIO_LOG_LEVEL=INFO

# ---- DB / 큐 ----
DATABASE_URL=postgresql+psycopg://genio:genio@localhost:5432/genio
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ---- LLM 기본값 (ADR 0001) ----
# 실제 키는 여기에 쓰지 않는다. 워크스페이스 설정 화면에서 등록하고 Fernet으로 암호화해 DB에 저장한다.
GENIO_BUILDER_LLM_PROVIDER=anthropic
GENIO_BUILDER_LLM_MODEL=claude-sonnet-5-5
GENIO_EMBEDDING_PROVIDER=openai
GENIO_EMBEDDING_MODEL=text-embedding-3-small
GENIO_EMBEDDING_DIM=1536
GENIO_DEFAULT_LOCALE=ko

# ---- 외부 호출 제한 ----
GENIO_HTTP_TIMEOUT_SECONDS=15
GENIO_HTTP_MAX_RESPONSE_BYTES=1048576
GENIO_CODE_NODE_TIMEOUT_SECONDS=5

# ---- 프런트 ----
VITE_API_BASE_URL=http://localhost:8000

# ---- docker-compose 전용 ----
POSTGRES_USER=genio
POSTGRES_PASSWORD=genio
POSTGRES_DB=genio
