# ---- 공통 ----
GENIO_ENV=dev
# 토큰 서명 키. 아무 긴 무작위 문자열.
GENIO_SECRET_KEY=change-me-to-a-long-random-string
# API 키·연결 정보 암호화용 Fernet 키.
# 생성: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GENIO_FERNET_KEY=
GENIO_LOG_LEVEL=INFO
# 공유 링크·초대 링크의 기본 주소(브라우저가 Origin을 보내면 그 주소를 우선 씀)
GENIO_PUBLIC_WEB_URL=http://localhost:5190
# 사용자가 없을 때 데모 회사·계정 5개 생성(비밀번호 genio1234!)
GENIO_SEED_DEMO=true

# ---- DB / 큐 (docker-compose가 컨테이너 안 주소로 덮어씀. 아래는 호스트에서 직접 실행할 때) ----
DATABASE_URL=postgresql+psycopg://genio:genio@127.0.0.1:55432/genio
REDIS_URL=redis://127.0.0.1:56379/0
CELERY_BROKER_URL=redis://127.0.0.1:56379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:56379/2

# ---- LLM 기본값 (ADR 0001) ----
# 실제 키는 여기에 쓰지 않는다. 워크스페이스 설정 > AI 연결에서 등록하고 Fernet으로 암호화해 DB에 저장한다.
GENIO_BUILDER_LLM_PROVIDER=anthropic
GENIO_BUILDER_LLM_MODEL=claude-sonnet-5-5
GENIO_EMBEDDING_PROVIDER=openai
GENIO_EMBEDDING_MODEL=text-embedding-3-small
GENIO_EMBEDDING_DIM=1536
GENIO_DEFAULT_LOCALE=ko

# ---- 실행 제한 (설계서 §5, §10) ----
GENIO_HTTP_TIMEOUT_SECONDS=15
GENIO_HTTP_MAX_RESPONSE_BYTES=1048576
GENIO_CODE_NODE_TIMEOUT_SECONDS=10
GENIO_NODE_TIMEOUT_SECONDS=60
GENIO_RUN_TIMEOUT_SECONDS=600
GENIO_PUBLIC_RATE_LIMIT_PER_MINUTE=30

# ---- docker-compose 전용 ----
POSTGRES_USER=genio
POSTGRES_PASSWORD=genio
POSTGRES_DB=genio

# 동시 사용자 처리(부하 시험 2026-11-03, docs/loadtest-2026-11-03.md)
# API 프로세스 수(CPU 코어 수 정도), 프로세스당 작업 스레드 수, 프로세스당 DB 연결 수
GENIO_API_WORKERS=4
GENIO_API_THREADS=200
GENIO_DB_POOL_SIZE=10
GENIO_DB_MAX_OVERFLOW=10

# ---- v0.8 운영 안전 (docs/runbook.md "v0.8 운영 안전") ----
# 올린 파일·지식 문서 본문을 둘 곳: db(기본, 지금과 같음) | disk | s3. 바꾼 뒤에도 이미 올린 파일은 그대로 읽힌다.
GENIO_STORAGE=db
# disk 모드: 컨테이너 안 저장 폴더(compose가 filestore 볼륨을 붙여 준다)
GENIO_STORAGE_DIR=/data/files
# s3 모드(AWS S3 또는 S3 호환 서버). 접근 키·비밀 키는 로그에 남지 않는다.
GENIO_S3_ENDPOINT_URL=
GENIO_S3_BUCKET=
GENIO_S3_REGION=us-east-1
GENIO_S3_ACCESS_KEY=
GENIO_S3_SECRET_KEY=
# MinIO·RustFS처럼 주소 뒤에 버킷을 붙이는 서버는 true
GENIO_S3_PATH_STYLE=false
GENIO_S3_PREFIX=genio/

# 코드 실행 격리 서버: 비우면 서버 안에서 실행(지금과 같음). 켜려면 둘 다 정하고
# COMPOSE_PROFILES=sandbox docker compose up -d --build
GENIO_SANDBOX_URL=
GENIO_SANDBOX_KEY=
# SANDBOX_MEMORY_MB=512
# SANDBOX_MAX_CONCURRENT=4

# 오류 수집(Sentry). 비우면 아무것도 보내지 않는다. 사용자·요청 정보는 보내지 않는다.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
