{
  "$defs": {
    "GraphEdge": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "target": {
          "title": "Target",
          "type": "string"
        },
        "sourceHandle": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sourcehandle"
        },
        "targetHandle": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Targethandle"
        }
      },
      "required": ["id", "source", "target"],
      "title": "GraphEdge",
      "type": "object"
    },
    "GraphNode": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "title": "Id",
          "type": "string"
        },
        "type": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Type",
          "type": "string"
        },
        "position": {
          "$ref": "#/$defs/Position"
        },
        "data": {
          "additionalProperties": true,
          "title": "Data",
          "type": "object"
        },
        "disabled": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Disabled"
        }
      },
      "required": ["id", "type"],
      "title": "GraphNode",
      "type": "object"
    },
    "GraphNote": {
      "additionalProperties": false,
      "description": "캔버스 메모(실행과 무관). n8n의 스티커 메모.",
      "properties": {
        "id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "text": {
          "default": "",
          "maxLength": 5000,
          "title": "Text",
          "type": "string"
        },
        "position": {
          "$ref": "#/$defs/Position"
        },
        "width": {
          "default": 220,
          "maximum": 1200,
          "minimum": 80,
          "title": "Width",
          "type": "number"
        },
        "height": {
          "default": 140,
          "maximum": 1200,
          "minimum": 60,
          "title": "Height",
          "type": "number"
        },
        "color": {
          "default": "yellow",
          "enum": ["yellow", "blue", "green", "pink", "gray"],
          "title": "Color",
          "type": "string"
        }
      },
      "required": ["id"],
      "title": "GraphNote",
      "type": "object"
    },
    "Position": {
      "properties": {
        "x": {
          "default": 0,
          "title": "X",
          "type": "number"
        },
        "y": {
          "default": 0,
          "title": "Y",
          "type": "number"
        }
      },
      "title": "Position",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "version": {
      "default": 1,
      "title": "Version",
      "type": "integer"
    },
    "nodes": {
      "items": {
        "$ref": "#/$defs/GraphNode"
      },
      "title": "Nodes",
      "type": "array"
    },
    "edges": {
      "items": {
        "$ref": "#/$defs/GraphEdge"
      },
      "title": "Edges",
      "type": "array"
    },
    "variables": {
      "additionalProperties": true,
      "title": "Variables",
      "type": "object"
    },
    "notes": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/GraphNote"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Notes"
    }
  },
  "title": "Graph",
  "type": "object"
}
