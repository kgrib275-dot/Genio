{
  "key": "linear",
  "type": "connector",
  "name": "Linear",
  "summary": "리니어 팀에 이슈를 만들어요(팀 목록 조회 포함).",
  "version": "1.0.0",
  "publisher": "platform",
  "price": 0,
  "category": "개발·업무관리",
  "tags": [
    "linear",
    "리니어",
    "이슈",
    "개발",
    "버그"
  ],
  "requires": {
    "credentials": [
      {
        "key": "api_key",
        "label": "개인 API 키(lin_api_...)",
        "secret": true,
        "required": true
      }
    ]
  },
  "actions": [
    {
      "key": "create_issue",
      "label": "이슈 만들기",
      "input_schema": {
        "type": "object",
        "properties": {
          "team_id": {
            "type": "string",
            "title": "팀 id('팀 목록'으로 확인)"
          },
          "title": {
            "type": "string",
            "title": "제목"
          },
          "description": {
            "type": "string",
            "title": "설명(마크다운)"
          },
          "priority": {
            "type": "integer",
            "title": "우선순위(0 없음·1 긴급·2 높음·3 보통·4 낮음)"
          }
        },
        "required": [
          "team_id",
          "title"
        ]
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "identifier": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        },
        "required": []
      }
    },
    {
      "key": "list_teams",
      "label": "팀 목록",
      "input_schema": {
        "type": "object",
        "properties": {},
        "required": []
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "count": {
            "type": "integer"
          },
          "text": {
            "type": "string"
          },
          "teams": {
            "type": "array"
          }
        },
        "required": []
      }
    }
  ],
  "permissions": [
    "network:api.linear.app"
  ]
}
