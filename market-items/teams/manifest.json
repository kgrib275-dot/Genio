        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "title": "보낼 내용"
          },
          "title": {
            "type": "string",
            "title": "제목(선택)"
          }
        },
        "required": [
          "text"
        ]
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "sent": {
            "type": "boolean"
          }
        },
        "required": []
      }
    }
  ],
  "permissions": [
    "network:logic.azure.com",
    "network:powerplatform.com",
    "network:webhook.office.com"
  ]
}
