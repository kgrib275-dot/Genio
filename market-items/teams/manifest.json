{
  "key": "teams",
  "type": "connector",
  "name": "Microsoft Teams",
  "summary": "Teams 채널에 카드 메시지를 보내요(워크플로 웹후크).",
  "version": "1.0.0",
  "publisher": "platform",
  "price": 0,
  "category": "메신저",
  "tags": [
    "teams",
    "팀즈",
    "microsoft",
    "메신저",
    "알림"
  ],
  "requires": {
    "credentials": [
      {
        "key": "webhook_url",
        "label": "워크플로 웹후크 주소",
        "secret": true,
        "required": true
      }
    ]
  },
  "actions": [
    {
      "key": "send_message",
      "label": "메시지 보내기",
