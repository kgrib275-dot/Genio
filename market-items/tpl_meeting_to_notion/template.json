{
  "version": 1,
  "nodes": [
    {
      "id": "n1",
      "type": "input",
      "position": {
        "x": 0,
        "y": 0
      },
      "data": {
        "label": "회의 메모",
        "fields": [
          {
            "key": "title",
            "label": "회의 이름",
            "type": "text",
            "required": true
          },
          {
            "key": "message",
            "label": "메모",
            "type": "text",
            "required": true
          }
        ]
      }
    },
    {
      "id": "n2",
      "type": "llm",
      "position": {
        "x": 300,
        "y": 0
      },
      "data": {
        "label": "회의록 정리",
        "provider": "default",
        "temperature": 0.3,
        "system": "회의 메모를 '논의 내용', '결정 사항', '할 일(담당·기한)' 세 문단으로 정리하세요. 문단 사이는 빈 줄. 메모에 없는 내용은 쓰지 마세요.",
        "prompt": "{{n1.message}}"
      }
    },
    {
      "id": "n3",
      "type": "connector",
      "position": {
        "x": 600,
        "y": 0
      },
      "data": {
        "label": "노션에 저장",
        "connector": "notion",
        "credential_id": "{{credential:notion}}",
        "action": "create_page",
        "params": {
          "database_id": "",
          "title": "{{n1.title}}",
          "content": "{{n2.text}}"
        }
      }
    },
    {
      "id": "n4",
      "type": "output",
      "position": {
        "x": 900,
        "y": 0
      },
      "data": {
        "label": "결과",
        "template": "회의록을 만들었어요: {{n3.url}}"
      }
    }
  ],
  "edges": [
    {
      "id": "e1",
      "source": "n1",
      "target": "n2"
    },
    {
      "id": "e2",
      "source": "n2",
      "target": "n3"
    },
    {
      "id": "e3",
